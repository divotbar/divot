{
  "version": 2,
  "appearance": {
    "family": "dracula",
    "mode": "dark",
    "accent": "#B7CEFF",
    "material": "opaque"
  },
  "layout": {
    "height": 34,
    "padding": 14,
    "notchGap": 10
  },
  "left": [
    "workspaces",
    "front-app"
  ],
  "right": [
    "battery",
    "network",
    "volume",
    "clock"
  ],
  "widgets": {
    "workspaces": {
      "adapter": "aerospace",
      "showEmpty": true,
      "showAppIcons": true
    },
    "front-app": {
      "showIcon": true,
      "showName": true
    }
  }
}
